{
    "id": "krita_env@0.1",
    "version": "0.1",
    "base": "ubuntu-gnome-systemd_highres",
    "description": "Krita digital painting environment for image editing, format conversion, and layer manipulation tasks.",
    "category": "creative",
    "tags": ["linux", "desktop", "image-editing", "digital-art", "krita"],
    "resources": {
        "cpu": 4,
        "mem_gb": 4,
        "gpu": 0,
        "net": true
    },
    "mounts": [
        {"source": "benchmarks/cua_world/environments/krita_env/scripts", "target": "/workspace/scripts", "mode": "ro"},
        {"source": "benchmarks/cua_world/environments/krita_env/config", "target": "/workspace/config", "mode": "ro"},
        {"source": "benchmarks/cua_world/environments/krita_env/tasks", "target": "/workspace/tasks", "mode": "ro"},
        {"source": "benchmarks/cua_world/environments/krita_env/data", "target": "/workspace/data", "mode": "ro"}
    ],
    "hooks": {
        "pre_start": "/workspace/scripts/install_krita.sh",
        "post_start": "/workspace/scripts/setup_krita.sh"
    },
    "security": {
        "user": "root",
        "cap_drop": ["ALL"],
        "privileged": true,
        "use_systemd": true,
        "mount_cgroups": true,
        "cgroupns_host": true,
        "tmpfs_run": true
    },
    "vnc": {"password": "password"}
}
